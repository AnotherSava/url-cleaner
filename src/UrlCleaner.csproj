<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>Another URL Cleaner</Product>
    <AssemblyTitle>Another URL Cleaner</AssemblyTitle>
    <!-- The confirm window renders sharply on a scaled second monitor only with per-monitor DPI awareness. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Core/ is its own project; without this the exe would compile its sources and its obj/ too. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Core/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Core\UrlCleaner.Core.csproj" />
  </ItemGroup>

</Project>